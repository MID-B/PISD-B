# Tambahkan ke .env.local dan Environment Variables Vercel. Jangan commit nilainya.
# Pilih Azure Translator Free F0 secara manual di Azure Portal.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Opsional: baca metrik pemakaian dari Azure Monitor, bukan untuk menerjemahkan teks.
# Service principal cukup diberi Monitoring Reader pada resource Translator ini saja.
AZURE_TRANSLATOR_RESOURCE_ID=/subscriptions/UUID/resourceGroups/NAMA/providers/Microsoft.CognitiveServices/accounts/NAMA
AZURE_MONITOR_TENANT_ID=
AZURE_MONITOR_CLIENT_ID=
AZURE_MONITOR_CLIENT_SECRET=
